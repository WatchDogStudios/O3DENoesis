<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,24" CornerRadius="14"
            Background="#E61E2230" BorderBrush="#FF6C8CFF" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel Opacity="0.85">
            <TextBlock Text="Hello, NoesisGUI in O3DE" FontFamily="Fonts/#Open Sans" FontSize="44" Foreground="White"/>
            <TextBlock Text="Rendered through Atom" FontFamily="Fonts/#Open Sans" FontSize="18"
                       Foreground="#FFB8C4FF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <Ellipse Width="64" Height="64" Margin="0,16,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#b3b3686c" Offset="0"/>
                        <GradientStop Color="#FFFF6C8C" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Grid Width="220" Height="44" Margin="0,18,0,0">
                <Rectangle RadiusX="8" RadiusY="8">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="#FF2E3550"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Fill" Value="#FF6C8CFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="Hover me" FontFamily="Fonts/#Open Sans" FontSize="16" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>
    </Border>
</Grid>
